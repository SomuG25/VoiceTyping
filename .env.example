# Voice Typing — Environment Configuration
#
# No API key required! The app uses local faster-whisper + silero-vad
# and runs entirely offline on your PC.
#
# Optional: whisper settings can also be set in config.json
# WHISPER_MODEL=base          # tiny, base, small, medium, large-v3
# WHISPER_DEVICE=auto         # auto, cpu, cuda
# VAD_THRESHOLD=0.5           # 0.0-1.0, lower = more sensitive
